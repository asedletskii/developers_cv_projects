# Только для docker-compose.prod.yml — прод-стек на сервере. .env создаётся один раз вручную
# на сервере (в git не попадает) на основе этого файла; CI его не трогает и не видит.

# Образы: домен GHCR совпадает с репозиторием (owner/repo в нижнем регистре)
FRONTEND_IMAGE=ghcr.io/asedletskii/developers_cv_projects/frontend
BACKEND_IMAGE=ghcr.io/asedletskii/developers_cv_projects/backend
IMAGE_TAG=latest

# Домен фронта. Реальный домен (например cv.example.com) включает автоматический HTTPS в Caddy.
# Без домена (:80) — обычный HTTP, подходит для деплоя по IP.
FRONTEND_ADDRESS=:80

# Уважать ли «Не отслеживать» (DNT) и Global Privacy Control: при true трекер на публичной странице не
# запускается у посетителей с таким сигналом. Применяется при перезапуске контейнера, пересборка не нужна.
RESPECT_DO_NOT_TRACK=true

# --- переменные ниже уходят в backend-контейнер как есть (см. backend/.env.example) ---
APP_ENV=production
APP_NAME=developers-cv-api
APP_VERSION=0.1.0

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_TLS_ENABLED=false
HTTP_TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=50
RATE_LIMIT_BURST=100

LOG_LEVEL=info
LOG_FORMAT=json

# Не обязателен: браузер ходит на бэкенд через тот же origin (Caddy), поэтому CORS в проде не
# участвует. Оставлено на случай прямых запросов к API в обход фронта.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CORS_ALLOW_CREDENTIALS=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=developers-cv-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=false

PROMETHEUS_ENABLED=true

POSTGRES_DB=developers_cv
POSTGRES_USER=developers_cv
POSTGRES_PASSWORD=change-me-postgres
