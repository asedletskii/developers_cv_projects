# Только для docker-compose.prod.yml — прод-стек на сервере. .env создаётся один раз вручную
# на сервере (в git не попадает) на основе этого файла; CI его не трогает и не видит.

# Образы: домен GHCR совпадает с репозиторием (owner/repo в нижнем регистре)
FRONTEND_IMAGE=ghcr.io/asedletskii/developers_cv_projects/frontend
BACKEND_IMAGE=ghcr.io/asedletskii/developers_cv_projects/backend
IMAGE_TAG=latest

# Уважать ли «Не отслеживать» (DNT) и Global Privacy Control: при true трекер на публичной странице не
# запускается у посетителей с таким сигналом. Применяется при перезапуске контейнера, пересборка не нужна.
RESPECT_DO_NOT_TRACK=true

# Уважать ли «Не отслеживать» (DNT) и Global Privacy Control: при true трекер на публичной странице не
# запускается у посетителей с таким сигналом. Применяется при перезапуске контейнера, пересборка не нужна.
RESPECT_DO_NOT_TRACK=true

# --- переменные ниже уходят в backend-контейнер как есть (см. backend/.env.example) ---
APP_ENV=production
APP_NAME=developers-cv-api
APP_VERSION=0.1.0

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
METRICS_ADDR=127.0.0.1:9090
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_TLS_ENABLED=false
HTTP_TLS_CERT_FILE=/run/secrets/tls.crt
HTTP_TLS_KEY_FILE=/run/secrets/tls.key
# Caddy закреплён за адресом 172.30.240.2 в выделенной proxy-сети Compose.
HTTP_TRUSTED_PROXIES=172.30.240.2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=50
RATE_LIMIT_BURST=100

LOG_LEVEL=info
LOG_FORMAT=json

# Не обязателен: браузер ходит на бэкенд через тот же origin (Caddy), поэтому CORS в проде не
# участвует. Оставлено на случай прямых запросов к API в обход фронта.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CORS_ALLOW_CREDENTIALS=true

# Авторизация в production — только Telegram OIDC. Замените все placeholders до запуска.
AUTH_MODE=telegram
AUTH_TELEGRAM_CLIENT_ID=replace-me-telegram-client-id
AUTH_TELEGRAM_CLIENT_SECRET=replace-me-telegram-client-secret
AUTH_TELEGRAM_REDIRECT_URL=https://your-domain.example/api/v1/auth/telegram/callback
AUTH_TELEGRAM_ISSUER_URL=https://oauth.telegram.org
AUTH_SESSION_ABSOLUTE_TTL=720h
AUTH_SESSION_IDLE_TTL=168h
AUTH_SESSION_TOUCH_INTERVAL=5m
AUTH_TRANSACTION_TTL=5m
AUTH_COOKIE_NAME=__Host-session
AUTH_COOKIE_SECURE=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_START_PER_MINUTE=5
AUTH_RATE_LIMIT_START_BURST=5
AUTH_RATE_LIMIT_CALLBACK_PER_MINUTE=20
AUTH_RATE_LIMIT_CALLBACK_BURST=20

CONTACT_VIEW_RATE_LIMIT_ENABLED=true
CONTACT_VIEW_RATE_LIMIT_PER_MINUTE=3
CONTACT_VIEW_RATE_LIMIT_BURST=2
ANALYTICS_EVENTS_RATE_LIMIT_ENABLED=true
ANALYTICS_EVENTS_RATE_LIMIT_PER_MINUTE=30
ANALYTICS_EVENTS_RATE_LIMIT_BURST=10

TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=replace-me-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=your-domain.example
TURNSTILE_EXPECTED_ACTION=contact_view
TURNSTILE_TIMEOUT=5s

ANALYTICS_VISITOR_SECRET=replace-me-with-a-random-32-byte-secret
ANALYTICS_SUSPECT_BURST=20
ANALYTICS_SUSPECT_WINDOW=1m
ANALYTICS_CLICK_RETENTION_DAYS=90
ANALYTICS_VIEW_RETENTION_DAYS=365

OTEL_ENABLED=false
OTEL_SERVICE_NAME=developers-cv-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLE_RATIO=0.1

PROMETHEUS_ENABLED=true

POSTGRES_DB=developers_cv
POSTGRES_USER=developers_cv
POSTGRES_PASSWORD=replace-me-with-a-long-base64url-secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Только для текущей топологии: PostgreSQL-контейнер на том же Docker-хосте, без опубликованного порта,
# backend и migrations подключены к отдельной internal data-сети. Шифруется HTTPS до Caddy,
# но не соединение backend/migrations -> PostgreSQL. Caddy не участвует в DB-соединении.
# Если БД станет внешней/удалённой или выйдет за эту границу доверия: включить TLS на PostgreSQL,
# настроить CA/hostname и использовать verify-full; одного изменения sslmode недостаточно.
POSTGRES_SSLMODE=disable
POSTGRES_STATEMENT_TIMEOUT=15s
POSTGRES_LOCK_TIMEOUT=3s
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=1m
POSTGRES_SLOW_QUERY_THRESHOLD=500ms
POSTGRES_MAX_CONNS=10
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

PROXY_NETWORK_SUBNET=172.30.240.0/24
CADDY_PROXY_IP=172.30.240.2
