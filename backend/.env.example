APP_ENV=development
APP_VERSION=0.1.0

# Mock-аутентификация доступна только в сборке с `-tags=devauth`.
# Для локального запуска используйте `make run-mock-auth`; production Dockerfile
# собирает без devauth. Mock разрешён только при APP_ENV=development или test.
# Для staging/production используйте AUTH_MODE=telegram.
AUTH_MODE=mock
AUTH_TELEGRAM_CLIENT_ID=
AUTH_TELEGRAM_CLIENT_SECRET=
AUTH_TELEGRAM_REDIRECT_URL=http://localhost:8080/api/v1/auth/telegram/callback
AUTH_TELEGRAM_ISSUER_URL=https://oauth.telegram.org
AUTH_SESSION_ABSOLUTE_TTL=720h
AUTH_SESSION_IDLE_TTL=168h
AUTH_SESSION_TOUCH_INTERVAL=5m
AUTH_TRANSACTION_TTL=5m
# Cookie фиксированы: HttpOnly=true, SameSite=Lax, Path=/.
AUTH_COOKIE_NAME=session
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_START_PER_MINUTE=5
AUTH_RATE_LIMIT_START_BURST=5
AUTH_RATE_LIMIT_CALLBACK_PER_MINUTE=20
AUTH_RATE_LIMIT_CALLBACK_BURST=20

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
METRICS_ADDR=127.0.0.1:9090
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_TLS_ENABLED=false
HTTP_TLS_CERT_FILE=/run/secrets/tls.crt
HTTP_TLS_KEY_FILE=/run/secrets/tls.key
HTTP_TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=50
RATE_LIMIT_BURST=100
CONTACT_VIEW_RATE_LIMIT_ENABLED=true
CONTACT_VIEW_RATE_LIMIT_PER_MINUTE=3
CONTACT_VIEW_RATE_LIMIT_BURST=2

TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=contact_view
TURNSTILE_TIMEOUT=5s

LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=developers-cv-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLE_RATIO=0.1

PROMETHEUS_ENABLED=true

ANALYTICS_VISITOR_SECRET=change-me-to-a-random-32-byte-secret
ANALYTICS_SUSPECT_BURST=20
ANALYTICS_SUSPECT_WINDOW=1m
ANALYTICS_CLICK_RETENTION_DAYS=90
ANALYTICS_VIEW_RETENTION_DAYS=365

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=developers_cv
POSTGRES_USER=developers_cv
POSTGRES_PASSWORD=postgres-password

POSTGRES_SSLMODE=disable
POSTGRES_STATEMENT_TIMEOUT=15s
POSTGRES_LOCK_TIMEOUT=3s
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=1m
POSTGRES_SLOW_QUERY_THRESHOLD=500ms

POSTGRES_MAX_CONNS=10
POSTGRES_MAX_IDLE_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

ANALYTICS_EVENTS_RATE_LIMIT_ENABLED=true
ANALYTICS_EVENTS_RATE_LIMIT_PER_MINUTE=30
ANALYTICS_EVENTS_RATE_LIMIT_BURST=10
