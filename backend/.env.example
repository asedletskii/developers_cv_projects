APP_ENV=development
APP_NAME=developers-cv-api
APP_VERSION=0.1.0

AUTH_MODE=mock

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_TLS_ENABLED=false
HTTP_TLS_CERT_FILE=/run/secrets/tls.crt
HTTP_TLS_KEY_FILE=/run/secrets/tls.key
HTTP_TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=50
RATE_LIMIT_BURST=100

LOG_LEVEL=info
LOG_FORMAT=json

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=developers-cv-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=false

PROMETHEUS_ENABLED=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=developers_cv
POSTGRES_USER=developers_cv
POSTGRES_PASSWORD=postgres-password

POSTGRES_SSLMODE=disable
MINIO_ROOT_USER=developers_cv
MINIO_ROOT_PASSWORD=minio-password

POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
