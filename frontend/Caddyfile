{$FRONTEND_ADDRESS:80} {
	root * /srv
	encode zstd gzip

	# Соседние handle-блоки Caddy проверяет в порядке записи и применяет только первый
	# совпавший (в отличие от голых директив верхнего уровня вроде try_files/file_server,
	# которые выполняются по своему фиксированному глобальному приоритету независимо от
	# места в файле — из-за этого раньше index.html отдавался и на /api/*).
	# Именно handle, а не handle_path: бэкенд сам живёт на префиксе /api/v1, поэтому путь
	# на проксировании резать не нужно — handle_path обрезал бы /api и ломал маршрут.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
