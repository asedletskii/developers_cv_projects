{
  log {
    output stdout
    format json
  }
}

{$FRONTEND_ADDRESS:80} {
	root * /srv
	encode zstd gzip

	log

	# Рантайм-конфиг пишется при старте контейнера — браузер не должен держать старый
	@runtimeConfig path /config.js
	header @runtimeConfig Cache-Control "no-cache"
	
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
